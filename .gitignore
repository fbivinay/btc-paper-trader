# Data is rebuilt from data.binance.vision by ml/fetch_history.py -- 160MB of it,
# and it would be stale the moment it was committed.
data/
artifacts/
# models/ is tracked on purpose: the promoted checkpoint is ~245KB and
# versioning it with the code keeps every decision reproducible.
!models/
kaggle/code/*.py

# Secrets. Nothing here should ever exist, but make it impossible by accident.
.env
.env.*
*.key
access_token
kaggle.json

__pycache__/
*.pyc
.venv/
node_modules/
.next/

# Next.js
web/.next/
web/node_modules/
web/.env*.local
web/next-env.d.ts
